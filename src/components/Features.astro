---
import { features } from "../content/site";
import Icon from "./Icon.astro";
---

<section class="border-border border-t" aria-labelledby="features-title">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <h2 id="features-title" class="text-center text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      {features.title}
    </h2>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.items.map((item) => (
        <li class="border-border bg-card hover:border-primary/30 rounded-xl border p-5 transition-colors">
          <Icon name={item.icon} class="text-primary size-5" />
          <h3 class="mt-4 font-semibold">{item.title}</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
