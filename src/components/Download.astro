---
import { download, downloadTargets, links, release } from "../content/site";

const [verifyBefore, verifyAfter] = download.verify.text.split("{file}");
---

<section id="download" class="border-border scroll-mt-16 border-t" aria-labelledby="download-title">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="download-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">
        {download.title}
      </h2>
      <p class="text-muted-foreground mt-4 text-lg">{download.subtitle}</p>
      <p class="text-muted-foreground mt-3 text-sm">
        <span class="font-mono" data-release-version>
          v{release.version}
        </span>
        {" · "}
        <span class="font-mono" data-release-date>
          {release.date}
        </span>
        {" · "}
        <a href={links.changelog} class="hover:text-foreground underline underline-offset-4">
          Changelog
        </a>
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
      {downloadTargets.map((t) => (
        <div
          data-os-card={t.os}
          class="group border-border bg-card data-detected:border-primary/60 data-detected:shadow-glow flex flex-col rounded-xl border p-5 transition-colors"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold">{t.name}</h3>
              <p class="text-muted-foreground mt-0.5 text-sm">{t.detail}</p>
            </div>
            <span class="border-primary/40 text-primary hidden rounded-full border px-2 py-0.5 text-xs group-data-detected:inline">
              {download.detected}
            </span>
          </div>
          <ul class="mt-5 flex flex-col gap-2">
            {t.files.map((f, i) => (
              <li>
                <a
                  href={links.latestRelease}
                  data-asset-pattern={f.pattern}
                  class:list={[
                    "flex items-center justify-between gap-3 rounded-md border px-3 py-2.5 text-sm transition",
                    i === 0
                      ? "border-primary/40 bg-primary/10 hover:bg-primary/20"
                      : "border-border hover:border-primary/40",
                  ]}
                >
                  <span class="flex min-w-0 flex-col">
                    <span class="font-medium">
                      {f.label} <span class="text-muted-foreground font-mono font-normal">{f.ext}</span>
                    </span>
                    {i === 0 && <span class="text-primary text-xs">{download.recommended}</span>}
                  </span>
                  <span class="text-muted-foreground flex shrink-0 items-center gap-2 font-mono text-xs">
                    <span data-asset-size />
                    <svg
                      aria-hidden="true"
                      class="size-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 15V3" />
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <path d="m7 10 5 5 5-5" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="text-muted-foreground mt-auto pt-5 text-xs leading-relaxed">{download.steps[t.os]}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-warning/30 bg-warning/5 p-5">
        <h3 class="flex items-center gap-2 text-warning font-semibold">
          <svg
            aria-hidden="true"
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
          </svg>
          Unsigned installers
        </h3>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{download.unsignedNote}</p>
      </div>

      <div class="border-border bg-card rounded-xl border p-5">
        <h3 class="font-semibold">{download.verify.title}</h3>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          {verifyBefore}
          <a
            href={links.latestRelease}
            data-asset-pattern="^SHA256SUMS\.txt$"
            class="text-primary font-mono underline underline-offset-4"
          >
            {download.checksums}
          </a>
          {verifyAfter}
        </p>
        <pre class="bg-background border-border mt-3 overflow-x-auto rounded-md border p-3 font-mono text-xs leading-relaxed"><code><span class="text-muted-foreground"># Windows (PowerShell)</span>
{download.verify.commands.windows}
<span class="text-muted-foreground"># macOS / Linux</span>
{download.verify.commands.unix}</code></pre>
      </div>
    </div>

    <p class="mt-8 text-center text-sm">
      <a href={links.releases} class="text-muted-foreground hover:text-foreground underline underline-offset-4">
        {download.allReleases}
      </a>
    </p>
  </div>
</section>

<script>
  import "../scripts/download";
</script>
