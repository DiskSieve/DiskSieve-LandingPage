---
import { faq } from "../content/site";
---

<section id="faq" class="border-border scroll-mt-16 border-t" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
    <h2 data-reveal id="faq-title" class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">
      {faq.title}
    </h2>

    <div data-reveal class="border-border bg-card mt-12 divide-border divide-y rounded-xl border">
      {faq.items.map((item) => (
        <details class="group">
          <summary class="hover:text-primary flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-medium transition-colors [&::-webkit-details-marker]:hidden">
            {item.q}
            <svg
              aria-hidden="true"
              class="text-muted-foreground size-4 shrink-0 transition-transform group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="text-muted-foreground -mt-1 px-5 pb-5 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
