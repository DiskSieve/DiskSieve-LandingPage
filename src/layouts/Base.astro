---
import "@fontsource-variable/geist";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Logo from "../assets/logo.svg";
import { footer, links, meta, nav } from "../content/site";
import { ogImage, structuredData, webmcpOriginTrial } from "../content/seo";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage.src, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0D0C" />
    <!-- The headline font, fetched with the HTML instead of after the CSS is parsed. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" title="DiskSieve for AI assistants (llms.txt)" href="/llms.txt" />
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    {webmcpOriginTrial && <meta http-equiv="origin-trial" content={webmcpOriginTrial} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DiskSieve" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData()).replaceAll("<", "\\u003c")}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-primary text-primary-foreground sr-only z-50 rounded-md px-4 py-2 font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="border-border bg-background/80 sticky top-0 z-40 border-b backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <Logo aria-hidden="true" class="size-8" />
          DiskSieve
        </a>
        <nav aria-label="Main" class="ml-auto hidden items-center gap-6 text-sm sm:flex">
          {nav.map((item) => (
            <a href={item.href} class="text-muted-foreground hover:text-foreground transition-colors">
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href={links.repo}
          class="border-border hover:border-primary/50 hover:text-foreground text-muted-foreground ml-auto rounded-md border px-3 py-1.5 text-sm transition-colors sm:ml-0"
        >
          GitHub
        </a>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-border border-t">
      <div class="text-muted-foreground mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>
          © <span class="font-mono">{year}</span> DiskSieve. {footer.note}
        </p>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
          {footer.links.map((link) => (
            <a href={link.href} class="hover:text-foreground transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </footer>
    <script>
      import "../scripts/reveal";
      import "../scripts/webmcp";
    </script>
  </body>
</html>
