---
import "@fontsource-variable/geist";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DiskSieve — fast, offline disk space analyzer",
  description = "A fast, offline disk space analyzer for developers and power users. See what takes space, what is safe to delete and what grew since last time.",
} = Astro.props;

const repo = "https://github.com/DiskSieve/disksieve";
const nav = [
  { href: "#features", label: "Features" },
  { href: "#download", label: "Download" },
  { href: "#faq", label: "FAQ" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0D0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-primary text-primary-foreground sr-only z-50 rounded-md px-4 py-2 font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <header class="border-border bg-background/80 sticky top-0 z-40 border-b backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <!-- Placeholder mark until the app icon is copied in step 2.1. -->
          <span
            aria-hidden="true"
            class="bg-primary/15 ring-primary/40 grid size-7 place-items-center rounded-md ring-1"
          >
            <span class="bg-primary size-2.5 rounded-sm"></span>
          </span>
          DiskSieve
        </a>
        <nav aria-label="Main" class="ml-auto hidden items-center gap-6 text-sm sm:flex">
          {nav.map((item) => (
            <a href={item.href} class="text-muted-foreground hover:text-foreground transition-colors">
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href={repo}
          class="border-border hover:border-primary/50 hover:text-foreground text-muted-foreground ml-auto rounded-md border px-3 py-1.5 text-sm transition-colors sm:ml-0"
        >
          GitHub
        </a>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-border border-t">
      <div class="text-muted-foreground mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>
          © <span class="font-mono">{year}</span> DiskSieve. The app is MIT-licensed; this website and branding are all
          rights reserved.
        </p>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
          <a href={repo} class="hover:text-foreground transition-colors">
            GitHub
          </a>
          <a href={`${repo}/releases`} class="hover:text-foreground transition-colors">
            Releases
          </a>
          <a href={`${repo}/issues`} class="hover:text-foreground transition-colors">
            Issues
          </a>
          <a href={`${repo}/blob/main/CHANGELOG.md`} class="hover:text-foreground transition-colors">
            Changelog
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
