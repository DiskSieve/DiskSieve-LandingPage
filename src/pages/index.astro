---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import screenshot from "../assets/screenshot.png";
import { hero, links, release } from "../content/site";
---

<Base>
  <!-- Temporary hero; the real one is built in step 2.2. -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="text-primary font-mono text-sm">{hero.eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">{hero.title}</h1>
    <p class="text-muted-foreground mt-6 max-w-2xl text-lg">{hero.subtitle}</p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href={links.latestRelease}
        class="bg-primary text-primary-foreground shadow-glow rounded-md px-5 py-2.5 font-medium transition hover:brightness-110"
      >
        {hero.primaryCta}
      </a>
      <a
        href={links.repo}
        class="border-border bg-card hover:border-primary/50 rounded-md border px-5 py-2.5 font-medium transition-colors"
      >
        {hero.secondaryCta}
      </a>
      <span class="text-muted-foreground font-mono text-sm">
        v{release.version} · {release.date}
      </span>
    </div>
    <Image
      src={screenshot}
      alt={hero.screenshotAlt}
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1152px) 1104px, 100vw"
      loading="eager"
      class="border-border mt-16 rounded-lg border"
    />
  </section>
</Base>
